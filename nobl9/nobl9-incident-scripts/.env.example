# Nobl9 API Configuration
# Copy to .env and fill in. Do not commit .env.

# Recommended: client credentials (token generated automatically)
NOBL9_CLIENT_ID=your_client_id_here
NOBL9_CLIENT_SECRET=your_client_secret_here
NOBL9_ORG=your_organization_id_here

# Alternative: pre-generated API token
# NOBL9_API_TOKEN=your_api_token_here

# Optional
# NOBL9_BASE_URL=https://app.nobl9.com
